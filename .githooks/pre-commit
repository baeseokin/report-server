#!/usr/bin/env bash
# git pre-commit 훅 (사람이 직접 커밋할 때): 스테이징된 서버 변경과 관련된 테스트를 실행합니다.
#   ① 서버 API 테스트(jest) 전체 (약 5초)
#   ② 바뀐 API 를 실제로 호출하는 화면 E2E 케이스만 PC · iPhone · Android 에서 (report-form-ui 의 Playwright 사용)
#   - 이미 같은 내용으로 통과했으면(예: Claude 가 검증 후 커밋) 다시 실행하지 않습니다.
#   - 화면 E2E 가 다루지 않는 API 변경(E2E 미커버)은 경고만 하고 막지 않습니다.
#   - 실패하면 커밋을 막습니다. 자동 수정은 하지 않으니 Claude Code 에서 "/e2e" 로 수정을 요청하세요.
#   - 급할 때 우회: git commit --no-verify  (권장하지 않음)
#   - report-form-ui 위치가 ../report-form-ui 가 아니면 REPORT_FORM_UI_DIR 로 지정
#   - report-form-ui 가 없으면 서버 API 테스트만 실행합니다.
cd "$(git rev-parse --show-toplevel)" || exit 1
UI_DIR="${REPORT_FORM_UI_DIR:-../report-form-ui}"

if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
  echo "❌ [pre-commit] Docker 가 실행 중이 아니어서 테스트 DB를 띄울 수 없습니다. Docker 를 켠 뒤 다시 커밋하세요."
  exit 1
fi

if [[ ! -x "$UI_DIR/e2e/run-related.sh" ]]; then
  echo "⚠️  [pre-commit] report-form-ui($UI_DIR)를 찾을 수 없어 화면 E2E 는 건너뛰고 서버 API 테스트만 실행합니다."
  ./scripts/test-db.sh up >/dev/null && npm test --silent
  exit $?
fi

if E2E_IGNORE_UNCOVERED=1 REPORT_SERVER_DIR="$(pwd)" "$UI_DIR/e2e/run-related.sh" --server --check >/dev/null 2>&1; then
  exit 0
fi

REPORT_SERVER_DIR="$(pwd)" "$UI_DIR/e2e/run-related.sh" --server
RC=$?
if [[ $RC -ne 0 ]]; then
  echo ""
  echo "커밋이 중단되었습니다. 실패 원인을 고친 뒤 다시 커밋하거나, Claude Code 에서 /e2e 로 분석·수정을 요청하세요."
fi
exit $RC
