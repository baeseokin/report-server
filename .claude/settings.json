{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/e2e-before-commit.sh",
            "if": "Bash(git *)",
            "timeout": 30,
            "statusMessage": "커밋 전 테스트 검증 여부 확인 중..."
          }
        ]
      }
    ]
  }
}
